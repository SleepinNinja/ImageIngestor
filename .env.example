# ─────────────────────────────────────────────────────────────────────────────
# Places Photo Worker — environment variables
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Full asyncpg-compatible PostgreSQL DSN.
# Inside Docker Compose the host is "db" (the service name).
# For local development without Docker use "localhost".
# Inside Docker Compose containers use the service name "db" on its internal port 5432.
# If connecting from the host machine (psql, TablePlus) use localhost:5433.
DATABASE_URL=postgresql://postgres:postgres@db:5432/places

# ── Google Places API ─────────────────────────────────────────────────────────
# Required. Enable the "Places API (New)" in Google Cloud Console and create
# an API key with Places API scope.
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# ── Worker tuning ─────────────────────────────────────────────────────────────
# Number of rows the worker claims per batch.
# Larger batches reduce DB round-trips but hold row-level locks longer.
# Recommended range: 5–100
BATCH_SIZE=500

# Maximum concurrent outbound HTTP requests to the Google Places API per batch.
# Increase carefully — Google enforces per-second and per-day quotas.
# Recommended range: 3–20 (stay well below your QPS quota)
MAX_CONCURRENCY=5

# ── pgAdmin ───────────────────────────────────────────────────────────────────
# Credentials for the pgAdmin web UI at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
